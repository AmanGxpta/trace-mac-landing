# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# PostgreSQL connection string (used by Prisma and the app)
# Local: use the postgres:// URL from `npx prisma dev` (not prisma+postgres://).
# Production (Vercel): set DATABASE_URL in Project Settings → Environment Variables
# to a hosted Postgres URL (Prisma Postgres, Neon, Supabase, etc.).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Resend — forwards mail sent to the justrytrace.app inbound domain (e.g.
# support@justrytrace.app) to a personal inbox. See app/api/webhooks/resend.
# Dashboard → API Keys.
RESEND_API_KEY=
# Dashboard → Webhooks → the signing secret for the endpoint below.
RESEND_WEBHOOK_SECRET=
# Where inbound mail gets forwarded to.
RESEND_FORWARD_TO=
# Must be an address on a domain verified for sending in the Resend account.
# Defaults to support@justrytrace.app if unset.
RESEND_FORWARD_FROM=
