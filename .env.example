# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# PostgreSQL connection string (used by Prisma and the app)
# For local Prisma Postgres (`npx prisma dev`), use the direct postgres:// URL
# printed in the terminal — not the prisma+postgres:// proxy URL.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
