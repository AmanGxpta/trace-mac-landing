# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# PostgreSQL connection string (used by Prisma and the app)
# Local: use the postgres:// URL from `npx prisma dev` (not prisma+postgres://).
# Production (Vercel): set DATABASE_URL in Project Settings → Environment Variables
# to a hosted Postgres URL (Prisma Postgres, Neon, Supabase, etc.).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
